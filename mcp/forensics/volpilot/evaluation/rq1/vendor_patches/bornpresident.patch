+"""Tiny shim that satisfies bornpresident's ``python vol.py`` invocation
+pattern using the pip-installed volatility3 package.
+
+The bornpresident server runs ``[python, VOLATILITY_SCRIPT, *args]`` for
+every tool call. By setting VOLATILITY_SCRIPT to this wrapper, we let
+the server keep its subprocess-of-vol.py architecture intact while
+using the canonical volatility3 v2.28.0 package that ships with this
+isolated venv.
+"""
+
+from volatility3 import cli
+
+if __name__ == "__main__":
+    cli.main()
