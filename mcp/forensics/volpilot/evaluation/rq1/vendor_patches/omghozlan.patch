index 0000000..f33cb23
--- /dev/null
+++ b/run_stdio.py
@@ -0,0 +1,34 @@
+"""Stdio entry point for omghozlan's MCP server (eval-only).
+
+Upstream's `if __name__ == "__main__"` block runs `mcp.run_sse_async`,
+which serves the MCP protocol over SSE/HTTP. For E1 we want the
+per-tool-call cost of the MCP wrapper itself, not the transport, so
+this shim sets the required VOLATILITY_* env vars and invokes the same
+`mcp` object in stdio mode (FastMCP's other supported transport, used
+by bornpresident and gaffx).
+
+Side effect of importing `volatility_mcp_server`: the module-level
+VolatilityRunner constructor runs `_validate_paths()`, so VOLATILITY_*
+env vars must be set BEFORE the import.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+from pathlib import Path
+
+VENDOR = Path(__file__).resolve().parent
+VENV = VENDOR / ".venv"
+
+os.environ.setdefault("VOLATILITY_PYTHON", str(VENV / "Scripts" / "python.exe"))
+os.environ.setdefault("VOLATILITY_DIR", str(VENDOR))
+os.environ.setdefault("VOLATILITY_SCRIPT", str(VENDOR / "vol_wrapper.py"))
+os.environ.setdefault("SYMBOLS_DIR", str(VENDOR / "symbols"))
+
+sys.path.insert(0, str(VENDOR))
+
+from volatility_mcp_server import mcp  # noqa: E402
+
+if __name__ == "__main__":
+    mcp.run()
diff --git a/vol_wrapper.py b/vol_wrapper.py
new file mode 100644
index 0000000..93748c2
--- /dev/null
+++ b/vol_wrapper.py
@@ -0,0 +1,14 @@
+"""Tiny shim that satisfies omghozlan's ``python vol.py`` invocation
+pattern using the pip-installed volatility3 package.
+
+The omghozlan VolatilityRunner runs ``[python, VOLATILITY_SCRIPT, *args]``
+for every plugin call. By setting VOLATILITY_SCRIPT to this wrapper,
+the server keeps its subprocess-of-vol.py architecture intact while
+using the canonical volatility3 v2.28.0 package that ships with this
+isolated venv.
+"""
+
+from volatility3 import cli
+
+if __name__ == "__main__":
+    cli.main()
